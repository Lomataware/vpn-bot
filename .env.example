# ===== BOT =====
BOT_TOKEN=your_bot_token_here
ADMIN_ID=0
ADDITIONAL_ADMINS=

# ===== SUPPORT =====
SUPPORT_USERNAME=your_support_username
SUPPORT_PHONE=+79991234567
BANK_NAME=Т-Банк

# ===== MARZBAN =====
MARZBAN_URL=http://127.0.0.1:8000
MARZBAN_ADMIN_USERNAME=admin
MARZBAN_ADMIN_PASSWORD=your_admin_password
MARZBAN_VLESS_INBOUND=VLESS_INBOUND
MARZBAN_HYSTERIA_INBOUND=
DEFAULT_DATA_LIMIT_GB=100

# ===== TRIAL & PRICES =====
TRIAL_DAYS=3
PRICE_1_MONTH=100

# ===== CRYPTOBOT =====
CRYPTOBOT_TOKEN=your_cryptobot_token_here
CRYPTOBOT_ENABLED=false
CRYPTOBOT_TESTNET=true

# ===== HYSTERIA2 =====
HY2_SERVERS=vpn.example.com|Main
HY2_PORT=443
HY2_AUTH_TOKEN=your_secret_hy2_token
HY2_AUTH_HOST=0.0.0.0
HY2_AUTH_PORT=9443
HY2_AUTH_CERTFILE=/etc/letsencrypt/live/vpn.example.com/fullchain.pem
HY2_AUTH_KEYFILE=/etc/letsencrypt/live/vpn.example.com/privkey.pem
